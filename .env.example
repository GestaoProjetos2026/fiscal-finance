# ==============================================================
# CONFIGURAÇÕES DO AMBIENTE (Fiscal Finance)
# ==============================================================
# Copie este arquivo para um novo arquivo chamado ".env" na mesma pasta
# e ajuste as chaves de acordo com seu ambiente de execução.

# 🔑 Segurança & JWT
# Chave secreta de segurança para assinatura e integridade de tokens JWT locais do módulo Fiscal.
# DICA: Altere para uma hash criptográfica complexa e aleatória em produção.
SECRET_KEY=sua_chave_secreta_super_segura_aqui

# 📂 Persistência de Dados (SQLite)
# Caminho interno do banco de dados SQLite local.
# No Docker, configuramos como /app/data/app.db para persistir no volume montado com o host.
# Em desenvolvimento local em Windows/Mac, deixe vazio para usar o caminho padrão (data/app.db).
DB_PATH=/app/data/app.db

# 🌐 Conexão e Integração SSO com o Core Engine (Mapeamento de Host)
# Hostname de rede do Core Backend para chamadas de validação de autenticação (SSO) e M2M.
# No Docker Compose (mesma rede erp-network), use: http://erp-backend:3000
# Em desenvolvimento local na mesma máquina física, use: http://localhost:3000
CORE_BACKEND_URL=http://erp-backend:3000
CORE_ENGINE_URL=http://erp-backend:3000

# 🗄️ Compartilhamento de Banco de Dados (PostgreSQL do Core) - Opcional
# String de conexão do banco de dados PostgreSQL pertencente ao Core Engine.
# Utilizado em cenários onde o Fiscal precisa interagir diretamente no mesmo cluster.
DATABASE_URL=postgresql://admin:admin123@erp-postgres:5432/erp_core
