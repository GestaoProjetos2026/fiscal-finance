# ==============================================================
# CONFIGURAÇÕES DO AMBIENTE (Fiscal Finance)
# ==============================================================
# Copie este arquivo para ".env" e altere os valores para o seu ambiente local

# Chave secreta usada para assinar os tokens JWT (Mude em produção!)
SECRET_KEY=sua_chave_secreta_super_segura_aqui

# Caminho para o banco de dados SQLite
# No Docker, usaremos /app/data/app.db para persistir no volume
# Em ambiente local (Windows/Mac), pode deixar vazio que o sistema usa o caminho padrão (data/app.db)
DB_PATH=
