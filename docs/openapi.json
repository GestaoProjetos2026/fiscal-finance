{
  "openapi": "3.0.3",
  "info": {
    "title": "API Fiscal Finance",
    "description": "Documentação completa da API REST do sistema Fiscal Finance. Inclui endpoints internos (exigem JWT) e públicos (exigem API Key).",
    "version": "2.0.0",
    "contact": {
      "name": "Squad FISC",
      "url": "https://github.com/GestaoProjetos2026/Fiscal-Finance"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Desenvolvimento Local (Docker)"
    },
    {
      "url": "http://localhost:5000",
      "description": "Desenvolvimento Local (Direto)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT obtido via `/v1/fisc/auth/login`."
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY",
        "description": "Chave de API Pública. Ex: `FISC-PUBLIC-2026-SQUAD1`."
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ]
          },
          "data": {
            "type": "object",
            "nullable": true
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Produto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "preco_base": {
            "type": "number"
          },
          "aliquota_imposto": {
            "type": "number"
          },
          "estoque": {
            "type": "integer"
          }
        }
      }
    }
  },
  "paths": {
    "/v1/fisc/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Realiza o login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "senha": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/fisc/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Dados do usuário autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      }
    },
    "/v1/fisc/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout do usuário",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      }
    },
    "/v1/fisc/products": {
      "get": {
        "tags": [
          "Produtos"
        ],
        "summary": "Lista todos os produtos",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      },
      "post": {
        "tags": [
          "Produtos"
        ],
        "summary": "Cria um produto",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Produto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criado"
          }
        }
      }
    },
    "/v1/fisc/products/{sku}": {
      "get": {
        "tags": [
          "Produtos"
        ],
        "summary": "Busca produto por SKU",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      },
      "put": {
        "tags": [
          "Produtos"
        ],
        "summary": "Atualiza produto",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      },
      "delete": {
        "tags": [
          "Produtos"
        ],
        "summary": "Remove produto",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      }
    },
    "/v1/fisc/stock/entry": {
      "post": {
        "tags": [
          "Estoque"
        ],
        "summary": "Registra entrada de estoque",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Criado"
          }
        }
      }
    },
    "/v1/fisc/invoice/intent": {
      "post": {
        "tags": [
          "Nota Fiscal"
        ],
        "summary": "Calcula nota fiscal (previa)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      }
    },
    "/v1/fisc/invoice/confirm": {
      "post": {
        "tags": [
          "Nota Fiscal"
        ],
        "summary": "Confirma nota fiscal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Criado"
          }
        }
      }
    },
    "/v1/fisc/invoice/{numero}": {
      "get": {
        "tags": [
          "Nota Fiscal"
        ],
        "summary": "Busca nota fiscal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "numero",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      }
    },
    "/v1/fisc/cashflow/balance": {
      "get": {
        "tags": [
          "Caixa"
        ],
        "summary": "Saldo atual do caixa",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      }
    },
    "/v1/fisc/cashflow/expense": {
      "post": {
        "tags": [
          "Caixa"
        ],
        "summary": "Registra despesa",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Criado"
          }
        }
      }
    },
    "/v1/fisc/cashflow/statement": {
      "get": {
        "tags": [
          "Caixa"
        ],
        "summary": "Extrato de transacoes",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      }
    },
    "/v1/fisc/usuarios": {
      "get": {
        "tags": [
          "Usuários"
        ],
        "summary": "Lista usuários (Admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      },
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Cria usuário (Admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Criado"
          }
        }
      }
    },
    "/v1/fisc/usuarios/{id}/role": {
      "put": {
        "tags": [
          "Usuários"
        ],
        "summary": "Muda papel (Admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      }
    },
    "/v1/fisc/usuarios/{id}": {
      "delete": {
        "tags": [
          "Usuários"
        ],
        "summary": "Remove usuário (Admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      }
    },
    "/v1/public/fisc/products/{sku}": {
      "get": {
        "tags": [
          "API Pública"
        ],
        "summary": "Consultar produto",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      }
    },
    "/v1/public/fisc/stock/{sku}": {
      "get": {
        "tags": [
          "API Pública"
        ],
        "summary": "Consultar saldo",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      }
    },
    "/v1/public/fisc/cashflow/summary": {
      "get": {
        "tags": [
          "API Pública"
        ],
        "summary": "Resumo financeiro",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      }
    },
    "/v1/public/fisc/history/{sku}": {
      "get": {
        "tags": [
          "API Pública"
        ],
        "summary": "Histórico do produto",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          }
        }
      }
    }
  }
}